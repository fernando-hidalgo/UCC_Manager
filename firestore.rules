rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/codes/{codeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/tickets/{ticketId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      // Shared copies are removed only by the original owner's delete/purge (Admin).
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && resource.data.get("isSharedCopy", false) != true;
    }
    match /users/{userId}/prefs/{prefId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
